{
  "name": "@envelia/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configuraciones compartidas de TypeScript, ESLint y Prettier para Envelia.",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/react": "./eslint/react.js",
    "./prettier": "./prettier/index.js",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/nextjs.json": "./typescript/nextjs.json",
    "./typescript/nestjs.json": "./typescript/nestjs.json",
    "./typescript/react-library.json": "./typescript/react-library.json"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
