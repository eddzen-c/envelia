{
  "extends": "./base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "removeComments": true,
    "resolvePackageJsonExports": true,
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "target": "ES2023"
  }
}
