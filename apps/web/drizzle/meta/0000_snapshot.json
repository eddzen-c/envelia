      "checkConstraints": {
        "invitation_projects_project_id_format_check": {
          "name": "invitation_projects_project_id_format_check",
          "value": "\"invitation_projects\".\"project_id\" ~ '^[A-Za-z0-9][A-Za-z0-9_-]*$'"
        },
        "invitation_projects_owner_id_format_check": {
          "name": "invitation_projects_owner_id_format_check",
          "value": "\"invitation_projects\".\"owner_id\" ~ '^[A-Za-z0-9][A-Za-z0-9_-]*$'"
        },
        "invitation_projects_publication_id_format_check": {
          "name": "invitation_projects_publication_id_format_check",
          "value": "\"invitation_projects\".\"publication_id\" IS NULL OR \"invitation_projects\".\"publication_id\" ~ '^[A-Za-z0-9][A-Za-z0-9_-]*$'"
        },
        "invitation_projects_lifecycle_check": {
          "name": "invitation_projects_lifecycle_check",
          "value": "\n        (\n          \"invitation_projects\".\"status\" = 'draft'\n          AND \"invitation_projects\".\"publication_id\" IS NULL\n          AND \"invitation_projects\".\"published_at\" IS NULL\n          AND \"invitation_projects\".\"archived_at\" IS NULL\n        )\n        OR\n        (\n          \"invitation_projects\".\"status\" = 'published'\n          AND \"invitation_projects\".\"publication_id\" IS NOT NULL\n          AND \"invitation_projects\".\"published_at\" IS NOT NULL\n          AND \"invitation_projects\".\"archived_at\" IS NULL\n        )\n        OR\n        (\n          \"invitation_projects\".\"status\" = 'archived'\n          AND \"invitation_projects\".\"archived_at\" IS NOT NULL\n          AND\n          (\n            (\n              \"invitation_projects\".\"publication_id\" IS NULL\n              AND \"invitation_projects\".\"published_at\" IS NULL\n            )\n            OR\n            (\n              \"invitation_projects\".\"publication_id\" IS NOT NULL\n              AND \"invitation_projects\".\"published_at\" IS NOT NULL\n            )\n          )\n        )\n      "
        },
        "invitation_projects_updated_at_order_check": {
          "name": "invitation_projects_updated_at_order_check",
          "value": "\"invitation_projects\".\"updated_at\" >= \"invitation_projects\".\"created_at\""
        },
        "invitation_projects_published_at_order_check": {
          "name": "invitation_projects_published_at_order_check",
          "value": "\n        \"invitation_projects\".\"published_at\" IS NULL\n        OR\n        (\n          \"invitation_projects\".\"published_at\" >= \"invitation_projects\".\"created_at\"\n          AND \"invitation_projects\".\"published_at\" <= \"invitation_projects\".\"updated_at\"\n        )\n      "
        },
        "invitation_projects_archived_at_order_check": {
          "name": "invitation_projects_archived_at_order_check",
          "value": "\n        \"invitation_projects\".\"archived_at\" IS NULL\n        OR\n        (\n          \"invitation_projects\".\"archived_at\" >= \"invitation_projects\".\"created_at\"\n          AND \"invitation_projects\".\"archived_at\" <= \"invitation_projects\".\"updated_at\"\n        )\n      "
        },
        "invitation_projects_publication_archive_order_check": {
          "name": "invitation_projects_publication_archive_order_check",
          "value": "\n        \"invitation_projects\".\"published_at\" IS NULL\n        OR \"invitation_projects\".\"archived_at\" IS NULL\n        OR \"invitation_projects\".\"published_at\" <= \"invitation_projects\".\"archived_at\"\n      "
        }
      },
