# This file is the top-level EditorConfig configuration
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown allows two trailing spaces for explicit line breaks
[*.md]
trim_trailing_whitespace = false

# Windows command scripts
[*.{bat,cmd}]
end_of_line = crlf

# Makefiles require tabs
[Makefile]
indent_style = tab