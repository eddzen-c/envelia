{
  "name": "envelia",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma SaaS premium para crear, personalizar y enviar invitaciones digitales.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddzen-c/envelia.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@envelia/config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
